# Metricool-Zugangsdaten für den Server-Proxy (api/metricool.js).
# In Vercel unter: Project → Settings → Environment Variables eintragen.
# NIEMALS eine echte .env mit Token ins Repo committen.

METRICOOL_USER_TOKEN=hier-dein-api-token
METRICOOL_USER_ID=hier-deine-user-id
METRICOOL_BLOG_ID=hier-die-brand-id

# Claude-API-Schlüssel für den KI-Skript-Generator (api/script.js).
# Schlüssel erstellen unter console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Trends & Outlier – echte virale Instagram-Reels über Apify.
# Wird von scripts/refresh-trends.mjs genutzt (schreibt src/data/trends.json).
# APIFY_TOKEN: Apify → Settings → Integrations → API token.
APIFY_TOKEN=apify_api_...
# Optional: eigene Nischen-Accounts (kommagetrennt, überschreibt die Standardliste)
# TRENDS_IG_ACCOUNTS=finanzfluss,immocation,grahamstephan,biggerpockets

# News-Radar (api/news.js) – KOSTENLOS, kein Key nötig (zieht Google-News-RSS).
# Optional eigene RSS-Feeds (mit Komma getrennt) statt der Standard-Feeds:
# NEWS_FEEDS=https://deine-quelle.at/rss,https://andere-quelle.at/feed
# Die KI-Bewertung/Betextung der News nutzt automatisch den ANTHROPIC_API_KEY oben.
